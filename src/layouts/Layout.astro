---
import Prose from '../components/Prose.astro';
import TableOfContents from '../components/TableOfContents';
import '../styles/global.css';
import type { MarkdownLayoutProps } from 'astro';

type Props = MarkdownLayoutProps<{
  title: string;
  date: string;
}>;

const { frontmatter, headings } = Astro.props;
const pageTitle = `${frontmatter.title} - 驾照考试题库`;
---

<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content="驾照考试题库，帮助您轻松通过科目一考试" />
	</head>
	<body class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">
		<div class="flex justify-center relative">
			<!-- 主内容区 -->
			<main class="flex flex-col min-h-dvh max-w-3xl w-full px-6 pb-12 pt-18">
				<header class="mb-12">
					<h1 class="text-4xl font-bold leading-normal mb-2">{frontmatter.title}</h1>
					<span class="text-sm text-slate-500 dark:text-slate-400">更新于: {frontmatter.date.slice(0, 10)}</span>
				</header>
				<Prose>
					<slot />
				</Prose>
			</main>
			
			<!-- 侧边目录 -->
			<aside id="toc-container" class="fixed right-4 top-24 transition-all duration-300 ease-in-out z-10">
				<div class="relative">
					<!-- 切换按钮 -->
					<button 
						id="toggle-toc" 
						class="absolute -left-10 top-0 bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-l-md shadow-md transition-colors flex items-center justify-center"
						aria-label="切换目录"
						title="切换目录"
					>
						<svg id="toc-icon-show" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
						</svg>
						<svg id="toc-icon-hide" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
					
					<!-- 目录内容 -->
					<div id="toc-content" class="bg-white dark:bg-slate-900 rounded-lg shadow-md border border-slate-200 dark:border-slate-700 p-4 w-64 max-h-[80vh] overflow-y-auto">
						<h2 class="text-sm font-semibold mb-3 text-slate-700 dark:text-slate-300">目录</h2>
						<TableOfContents headings={headings} client:load />
					</div>
				</div>
			</aside>
		</div>

		<!-- 回到顶部按钮 -->
		<button 
			id="scroll-to-top" 
			class="fixed bottom-8 right-8 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full shadow-lg transition-all opacity-0 invisible z-50"
			aria-label="返回顶部"
			title="返回顶部"
		>
			<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
			</svg>
		</button>
	</body>
</html>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// DOM元素
		const scrollToTopButton = document.getElementById('scroll-to-top');
		const tocContent = document.getElementById('toc-content');
		const toggleButton = document.getElementById('toggle-toc');
		const showIcon = document.getElementById('toc-icon-show');
		const hideIcon = document.getElementById('toc-icon-hide');
		
		// 滚动处理
		const handleScroll = () => {
			if (window.scrollY > 300) {
				scrollToTopButton?.classList.remove('opacity-0', 'invisible');
				scrollToTopButton?.classList.add('opacity-100');
			} else {
				scrollToTopButton?.classList.remove('opacity-100');
				scrollToTopButton?.classList.add('opacity-0', 'invisible');
			}
		};
		
		// 回到顶部
		scrollToTopButton?.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
		
		// 目录状态
		const tocVisible = localStorage.getItem('tocVisible') !== 'false';
		
		// 设置目录初始状态
		const updateTocVisibility = (isVisible: boolean) => {
			if (isVisible) {
				tocContent?.classList.remove('hidden');
				showIcon?.classList.add('hidden');
				hideIcon?.classList.remove('hidden');
			} else {
				tocContent?.classList.add('hidden');
				showIcon?.classList.remove('hidden');
				hideIcon?.classList.add('hidden');
			}
		};
		
		// 初始化
		updateTocVisibility(tocVisible);
		window.addEventListener('scroll', handleScroll);
		handleScroll(); // 初始检查
		
		// 切换目录
		toggleButton?.addEventListener('click', () => {
			const isVisible = !tocContent?.classList.contains('hidden');
			updateTocVisibility(!isVisible);
			localStorage.setItem('tocVisible', (!isVisible).toString());
		});
	});
</script>