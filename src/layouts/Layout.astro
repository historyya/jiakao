---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageTransition from "../components/PageTransition.astro";
import Prose from "../components/Prose.astro";
import ScrollToTop from "../components/ScrollToTop";
import TableOfContents from "../components/TableOfContents";
import TocToggle from "../components/TocToggle";
import "../styles/global.css";
import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
  title: string;
  date: string;
}>;

const { frontmatter, headings } = Astro.props;
const pageTitle = `${frontmatter.title} - 驾照题库`;
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content="驾照考试题库，帮助您轻松通过科目一考试" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f172a"
      media="(prefers-color-scheme: dark)"
    />
  </head>
  <body
    class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors"
  >
    <PageTransition />
    <Header />

    <div class="flex-grow flex justify-center relative pt-16">
      <!-- 主内容区 -->
      <main class="flex flex-col max-w-3xl w-full px-4 sm:px-6 py-8 sm:py-12">
        <header class="mb-8 sm:mb-12 animate-fade-down">
          <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-2">
            {frontmatter.title}
          </h1>
          <span class="text-sm text-slate-500 dark:text-slate-400"
            >Last updated: {frontmatter.date.slice(0, 10)}</span
          >
        </header>
        <Prose>
          <slot />
        </Prose>
      </main>

      <!-- 侧边目录 -->
      <aside
        id="toc-container-desktop"
        class="fixed right-4 top-24 z-10 hidden lg:block"
      >
        <div class="relative">
          <!-- 切换按钮 -->
          <TocToggle
            contentId="toc-content-desktop"
            position="desktop"
            client:load
          />

          <!-- 目录内容 -->
          <div
            id="toc-content-desktop"
            class="bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm rounded-lg shadow-lg border border-slate-200 dark:border-slate-800 p-4 w-64 max-h-[80vh] overflow-y-auto transition-colors"
          >
            <h2
              class="text-sm font-semibold mb-3 text-slate-700 dark:text-slate-300"
            >
              目录
            </h2>
            <TableOfContents headings={headings} client:load />
          </div>
        </div>
      </aside>

      <aside
        id="toc-container-mobile"
        class="fixed bottom-22 right-8 z-10 lg:hidden"
      >
        <div class="relative">
          <TocToggle
            contentId="toc-content-mobile"
            position="mobile"
            client:load
          />

          <div
            id="toc-content-mobile"
            class="absolute bottom-full right-0 mb-2 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm rounded-lg shadow-lg border border-slate-200 dark:border-slate-800 p-4 w-64 max-h-[60vh] overflow-y-auto transition-colors hidden"
          >
            <h2
              class="text-sm font-semibold mb-3 text-slate-700 dark:text-slate-300"
            >
              目录
            </h2>
            <TableOfContents headings={headings} client:load />
          </div>
        </div>
      </aside>
    </div>

    <Footer />

    <!-- 回到顶部按钮 -->
    <ScrollToTop client:load />
  </body>
</html>

<script>
  // 页面加载时的动画效果
  document.addEventListener("DOMContentLoaded", () => {
    const mainContent = document.querySelector("main");
    if (mainContent) {
      mainContent.classList.add("animate-fade-in");
    }

    // 点击外部区域关闭移动版目录
    document.addEventListener("click", (e) => {
      const tocContentMobile = document.getElementById("toc-content-mobile");
      const tocToggleMobile = document.querySelector(
        "#toc-container-mobile button"
      );

      if (
        tocContentMobile &&
        !tocContentMobile.classList.contains("hidden") &&
        !tocContentMobile.contains(e.target as Node) &&
        e.target !== tocToggleMobile &&
        !tocToggleMobile?.contains(e.target as Node)
      ) {
        tocContentMobile.classList.add("hidden");
      }
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .animate-fade-down {
    animation: fadeDown 0.6s ease-out forwards;
  }
</style>
