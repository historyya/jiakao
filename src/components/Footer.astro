---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-8 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <!-- 版权信息 -->
        <div class="text-center md:text-left mb-4 md:mb-0">
          <p class="text-sm text-slate-500 dark:text-slate-400">
            &copy; {currentYear} Powered by Astro.
          </p>
        </div>
        
        <!-- 链接 -->
        <div class="flex space-x-6">
          <a href="/" title="隐私政策" class="text-sm text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors">
            Privacy
          </a>
          <a href="/" title="使用条款" class="text-sm text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors">
            Terms
          </a>
          <a href="/" title="联系我们" class="text-sm text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors">
            Contact
          </a>
        </div>
      </div>
    </div>
  </footer>